#!/usr/bin/env bash
#
# jq shim for Windows. The native jq.exe opens stdout in text mode and emits
# CRLF, so every value the engine reads back through `read`/`$(...)` carries a
# trailing \r that poisons positions ("1\r" is not a number) and labels. Strip
# the \r on the way out while preserving jq's real exit code, which the engine
# branches on (`... || printf '{}'`). Streaming through tr keeps the trailing
# newline that a `while read` loop needs.
here="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" 2>/dev/null && pwd)"
"$here/jq-bin.exe" "$@" | tr -d '\r'
exit "${PIPESTATUS[0]}"
