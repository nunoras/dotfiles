{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(*scratchpad/flow/*)",
      "Bash(gh pr merge *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "skillOverrides": {
    "mattpocock-skills:tdd": "off",
    "mattpocock-skills:code-review": "off",
    "mattpocock-skills:resolving-merge-conflicts": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/scripts/skills-sync.mjs\" --quiet",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$HOME/.claude/hooks/herdr-agent-state.ps1\" ] && powershell -NoProfile -ExecutionPolicy Bypass -File \"$HOME/.claude/hooks/herdr-agent-state.ps1\" session; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/scripts/prose-guard.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$HOME/.claude/scripts/poll-guard.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$HOME/.claude/scripts/pkill-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/scripts/verify-gate.mjs\"",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "node \"$HOME/.claude/statusline.mjs\""
  },
  "enabledPlugins": {
    "pstack@open-pstack": true,
    "mattpocock-skills@claude-plugins-official": true,
    "stripe@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "open-pstack": {
      "source": {
        "source": "git",
        "url": "https://github.com/ericlitman/open-pstack.git"
      }
    }
  },
  "feedbackDrafts": "off",
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "autoCompactWindow": 300000,
  "awaySummaryEnabled": false,
  "tui": "default",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": false,
  "autoMode": {
    "environment": [
      "The FellowStitch app repo is my own private repo. Merging PRs into staging is routine and approved; merging into main deploys and needs my explicit ask."
    ]
  }
}
