// Zed keymap — VSCode-style custom bindings
// Docs: https://zed.dev/docs/key-bindings
[
  // Global bindings (apply everywhere)
  {
    "bindings": {
      "ctrl-e": "project_panel::ToggleFocus",      // toggle Explorer / file tree
      "ctrl-t": "workspace::ToggleBottomDock",      // show/hide the terminal panel
      "ctrl-alt-s": "workspace::ToggleLeftDock",    // toggle the whole left sidebar
      "ctrl-p": "command_palette::Toggle"           // command palette on Ctrl+P
    }
  },

  // Jump from the editor down into the terminal
  {
    "context": "Editor",
    "bindings": {
      "ctrl-i": "terminal_panel::ToggleFocus"
    }
  },

  // While the terminal is focused, Alt+1..9 switches between terminal tabs
  {
    "context": "Terminal",
    "bindings": {
      "alt-1": ["pane::ActivateItem", 0],
      "alt-2": ["pane::ActivateItem", 1],
      "alt-3": ["pane::ActivateItem", 2],
      "alt-4": ["pane::ActivateItem", 3],
      "alt-5": ["pane::ActivateItem", 4],
      "alt-6": ["pane::ActivateItem", 5],
      "alt-7": ["pane::ActivateItem", 6],
      "alt-8": ["pane::ActivateItem", 7],
      "alt-9": ["pane::ActivateItem", 8]
    }
  }
]
